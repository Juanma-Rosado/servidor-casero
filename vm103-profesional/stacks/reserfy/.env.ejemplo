# Plantilla del .env del stack Reserfy. Copiar a .env y rellenar.
# El .env real nunca se sube al repositorio.
# Valores entre comillas simples; usar contraseñas largas solo con letras y números,
# porque 02-usuario-gestion.sh mete GESTION_DB_PASSWORD dentro de SQL.

# Dominios (pendiente de decisión: estos son los propuestos)
DOMINIO_RESERFY='reserfy.juanmarosado.com'
DOMINIO_RESTAURANTE='echalequeso.juanmarosado.com'
DOMINIO_GESTION='reserfy.casa.juanmarosado.com'

# Bases de datos
DB_RESERFY_ROOT_PASSWORD='cambiar'
DB_RESERFY_PASSWORD='cambiar'
DB_RESTAURANTE_ROOT_PASSWORD='cambiar'
DB_RESTAURANTE_PASSWORD='cambiar'
GESTION_DB_PASSWORD='cambiar'

# App de gestión (Flask)
GESTION_SECRET_KEY='cambiar'
GESTION_USUARIO='echalequeso'
GESTION_CONTRASENA='cambiar'

# Claves de WordPress de la web de Reserfy
RESERFY_AUTH_KEY='cambiar'
RESERFY_SECURE_AUTH_KEY='cambiar'
RESERFY_LOGGED_IN_KEY='cambiar'
RESERFY_NONCE_KEY='cambiar'
RESERFY_AUTH_SALT='cambiar'
RESERFY_SECURE_AUTH_SALT='cambiar'
RESERFY_LOGGED_IN_SALT='cambiar'
RESERFY_NONCE_SALT='cambiar'

# Claves de WordPress de la web de Échale Queso
RESTAURANTE_AUTH_KEY='cambiar'
RESTAURANTE_SECURE_AUTH_KEY='cambiar'
RESTAURANTE_LOGGED_IN_KEY='cambiar'
RESTAURANTE_NONCE_KEY='cambiar'
RESTAURANTE_AUTH_SALT='cambiar'
RESTAURANTE_SECURE_AUTH_SALT='cambiar'
RESTAURANTE_LOGGED_IN_SALT='cambiar'
RESTAURANTE_NONCE_SALT='cambiar'
