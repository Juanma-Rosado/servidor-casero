# Copia fuera de casa en el USB cifrado. La lanza la regla 99-copia-usb.rules al conectarlo.
[Unit]
Description=Copia de seguridad en el USB cifrado
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/copia-usb.sh
# La copia puede tardar: ~7,5 GB a velocidad de USB
TimeoutStartSec=3h
Nice=10
IOSchedulingClass=idle
